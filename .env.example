# Google Tag Manager container ID (e.g., GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# WhatConverts tracking script URL (account-specific subdomain + script ID).
# Example: https://s.ksrndkehqnwntyxlhgto.com/166796.js
# Loaded directly in <head> with beforeInteractive strategy so phone-number
# swapping happens before the user sees the page.
NEXT_PUBLIC_WHATCONVERTS_SCRIPT_URL=

# GoHighLevel embed host (white-label domain for this account).
# Defaults to https://connect.bekindlocal.com if unset.
NEXT_PUBLIC_GHL_EMBED_HOST=

# GoHighLevel form ID for the primary quote form on /get-quote.
# Defaults to the current "Contact Us" form (HmzNNWfcbWCRA1sBC3WD) if unset.
NEXT_PUBLIC_GHL_QUOTE_FORM_ID=
